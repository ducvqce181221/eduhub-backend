# Application
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
ENABLE_SWAGGER=true # Set to true to view Swagger API Docs in production (/api/docs)

# Database (PostgreSQL - Neon, Supabase, etc.)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/eduhub_db?schema=public

# Redis (Local TCP or Cloud Managed URL like Upstash / rediss://)
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# JWT Authentication
JWT_ACCESS_SECRET=eduhub-super-secret-access-token-key-2026
JWT_REFRESH_SECRET=eduhub-super-secret-refresh-token-key-2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary (Image Storage & CDN)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Cloudflare R2 (Video & Large Resource S3 Storage)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=eduhub-media
R2_PUBLIC_DOMAIN=https://media.eduhub.local

# Google OAuth2 Authentication
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Cloudflare Turnstile CAPTCHA (Bot Protection)
# Get from Cloudflare Dashboard -> Turnstile -> Add site
ENABLE_TURNSTILE=true
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
TURNSTILE_HOSTNAMES=localhost,127.0.0.1


